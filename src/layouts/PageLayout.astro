---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site.mjs';

const subtleSlide = {
  forwards: {
    old: {
      name: 'page-exit',
      duration: '150ms',
      easing: 'ease-out',
      fillMode: 'both',
    },
    new: {
      name: 'page-enter',
      duration: '280ms',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
  },
  backwards: {
    old: {
      name: 'page-exit-reverse',
      duration: '150ms',
      easing: 'ease-out',
      fillMode: 'both',
    },
    new: {
      name: 'page-enter-reverse',
      duration: '280ms',
      easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
      fillMode: 'both',
    },
  },
};

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = site.description,
  image,
} = Astro.props;
const documentTitle = title === site.name ? title : `${title} | ${site.shortName}`;
---

<BaseLayout title={documentTitle} description={description} image={image}>
  <div class="site-shell">
    <Header />

    <main transition:animate={subtleSlide}>
      <slot />
    </main>

    <Footer />
  </div>
</BaseLayout>

<style>
  .site-shell {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
  }
</style>
