---
import { getEntry, render } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const home = await getEntry('pages', 'home');

if (!home) {
  throw new Error('Home page content could not be found.');
}

const { Content } = await render(home);
---

<PageLayout
  title={home.data.title}
  description={home.data.description}
>
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Good Living Productions</p>

      <h1>Good Music, Good Living</h1>

      <div class="intro">
        <Content />
      </div>

      <a class="button" href="/listen/">
        Listen Now
      </a>
    </div>
  </section>
</PageLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(80vh, 850px);
    display: flex;
    align-items: center;
  }

  .hero::before {
    position: absolute;
    z-index: -1;
    top: 8%;
    left: 35%;
    width: min(70vw, 850px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(116 20 30 / 12%), transparent 68%);
    content: '';
    pointer-events: none;
  }

  .hero-inner {
    padding-block: 7rem;
  }

  .eyebrow {
    margin-bottom: 2rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 900px;
    margin-bottom: 2.5rem;
    font-weight: 500;
    font-size: clamp(3.5rem, 8vw, 7.5rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .intro {
    max-width: 650px;
    margin-bottom: 2.5rem;
  }

  .intro :global(p) {
    margin: 0;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.6;
  }

  .intro :global(h2) {
    display: none;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0.75rem 1.5rem;
    border: 1px solid var(--color-accent);
    background: var(--color-accent);
    color: var(--color-text);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition:
      background-color 160ms ease,
      color 160ms ease,
      border-color 160ms ease;
  }

  .button:hover {
    border-color: var(--color-text);
    background: transparent;
    color: var(--color-text);
  }

  @media (max-width: 640px) {
    .hero-inner {
      padding-block: 4rem;
    }

    .hero {
      min-height: min(76svh, 680px);
    }

    .eyebrow {
      margin-bottom: 1.25rem;
      font-size: 0.68rem;
    }

    h1 {
      margin-bottom: 1.5rem;
      font-size: clamp(2.85rem, 13vw, 4.25rem);
      line-height: 0.98;
    }

    .intro {
      margin-bottom: 1.75rem;
    }

    .intro :global(p) {
      font-size: 1rem;
    }
  }
</style>
