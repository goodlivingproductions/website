---
import { getCollection, getEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { site } from '../../data/site.mjs';

const [contact, services] = await Promise.all([
  getEntry('pages', 'contact'),
  getCollection('services'),
]);

if (!contact) throw new Error('Contact page content could not be found.');
const copy = contact.data.contact;
if (!copy) throw new Error('Contact page section labels could not be found.');
const sortedServices = services.sort((a, b) => a.data.order - b.data.order);

---

<PageLayout
  title={contact.data.title}
  description={contact.data.description}
>
  <section class="contact-content">
    <div class="container contact-grid">
      <div class="contact-primary">
        <p class="eyebrow">{copy.emailEyebrow}</p>
        <a class="email" href={`mailto:${site.contact.email}`}>
          {site.contact.email}<span aria-hidden="true"> ↗</span>
        </a>
      </div>

      <div class="contact-details">
        <div>
          <h2>{copy.servicesHeading}</h2>
          <ul>{sortedServices.map((service) => <li><a href={`/services/${service.id}/`}>{service.data.name}</a></li>)}</ul>
        </div>

        <div>
          <h2>{copy.educationHeading}</h2>
          <p>{copy.educationDescription}</p>
          <a class="education-link" href="/education/">{copy.educationLinkLabel}</a>
        </div>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .contact-content {
    padding-block: clamp(3rem, 8vh, 6rem);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
  }

  .contact-primary {
    padding-top: 0.25rem;
  }

  .email {
    display: block;
    width: fit-content;
    color: var(--color-text);
    font-size: clamp(1.25rem, 2.5vw, 2rem);
    line-height: 1.2;
    word-break: break-word;
    text-underline-offset: 0.25em;
  }

  .email:hover {
    color: var(--color-accent);
  }

  .contact-details {
    display: grid;
    gap: 2.5rem;
  }

  .contact-details h2 {
    margin-bottom: 0.75rem;
    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact-details ul {
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .contact-details li {
    padding-block: 0.35rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .contact-details li a {
    display: block;
    color: inherit;
  }

  .contact-details li a:hover {
    color: var(--color-text);
  }

  .contact-details p {
    margin-bottom: 0.75rem;
  }

  .education-link {
    display: inline-block;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    text-underline-offset: 0.2em;
  }

  .education-link:hover {
    color: var(--color-accent);
  }

  @media (max-width: 750px) {
    .contact-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
