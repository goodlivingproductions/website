---
import { getEntry, getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const listen = await getEntry('pages', 'listen');

if (!listen) {
  throw new Error('Listen page content could not be found.');
}

const [releases, artists, team] = await Promise.all([
  getCollection('releases'),
  getCollection('artists'),
  getCollection('team'),
]);

const sortedReleases = releases
  .sort((a, b) => {
    const dateA = a.data.releaseDate?.getTime() ?? 0;
    const dateB = b.data.releaseDate?.getTime() ?? 0;

    return dateB - dateA;
  })
  .slice(0, 6);

const sortedArtists = artists.sort((a, b) => {
  const featuredOrder = Number(b.data.featured) - Number(a.data.featured);
  return featuredOrder || a.data.name.localeCompare(b.data.name);
});

const productionTeam = team
  .map((member) => {
    const roles = [...new Set(
      releases.flatMap((release) =>
        release.data.goodLivingTeam
          .filter((credit) => credit.name === member.data.name)
          .flatMap((credit) => credit.roles),
      ),
    )];

    return {
      ...member,
      roles,
      initials: member.data.name
        .split(/\s+/)
        .map((part) => part[0])
        .slice(0, 2)
        .join('')
        .toUpperCase(),
    };
  })
  .sort((a, b) => {
    const featuredOrder = Number(b.data.featured) - Number(a.data.featured);
    return featuredOrder || a.data.name.localeCompare(b.data.name);
  });
---

<PageLayout
  title={listen.data.title}
  description={listen.data.description}
>
  <div class="portfolio-rows container">
    <section class="portfolio-row releases">
      <div class="portfolio-row-heading">
        <h2>Selected releases</h2>
      </div>

      {sortedReleases.length > 0 ? (
        <div class="portfolio-carousel" aria-label="Releases">
          {sortedReleases.map((release) => (
            <a class="portfolio-card" href={`/releases/${release.id}/`}>
              {release.data.cover ? (
                <div class="portfolio-image">
                  <img
                    src={release.data.cover}
                    alt={`${release.data.title} by ${release.data.artist}`}
                    loading="lazy"
                  />
                </div>
              ) : (
                <div class="portfolio-image placeholder">
                  <span>No Artwork</span>
                </div>
              )}

              <div class="portfolio-info">
                <h3>{release.data.title}</h3>
                <p>{release.data.artist}</p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">
          Releases will be added here soon.
        </p>
      )}
    </section>

    <section class="portfolio-row artists">
      <div class="portfolio-row-heading">
        <h2>Artists</h2>
      </div>

      {sortedArtists.length > 0 ? (
        <div class="portfolio-carousel" aria-label="Artists">
          {sortedArtists.map((artist) => (
            <a class="portfolio-card" href={`/artists/${artist.id}/`}>
              <div class="portfolio-image">
                {artist.data.image ? (
                  <img
                    src={artist.data.image}
                    alt={artist.data.name}
                    loading="lazy"
                  />
                ) : (
                  <span class="artist-placeholder">Artist</span>
                )}
              </div>

              <div class="portfolio-info">
                <h3>{artist.data.name}</h3>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">Artist profiles will be added here soon.</p>
      )}
    </section>

    <section class="portfolio-row production-team">
      <div class="portfolio-row-heading">
        <h2>Production Team</h2>
      </div>

      {productionTeam.length > 0 ? (
        <div class="portfolio-carousel" aria-label="Production team">
          {productionTeam.map((member) => (
            <a class="portfolio-card team-card" href={`/team/${member.id}/`}>
              <div class="portfolio-image">
                {member.data.image ? (
                  <img src={member.data.image} alt={member.data.name} loading="lazy" />
                ) : (
                  <span class="team-initials">{member.initials}</span>
                )}
              </div>
              <div class="portfolio-info">
                <h3>{member.data.name}</h3>
                <div class="team-tags">
                  {member.roles.map((role) => <span>{role}</span>)}
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="empty-state">Project team credits will appear here.</p>
      )}
    </section>
  </div>
</PageLayout>

<style>
  .portfolio-rows {
    width: min(100% - 2rem, 1320px);
    padding-block: 1.5rem 2rem;
  }

  .portfolio-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
    min-width: 0;
    padding-block: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .portfolio-row-heading h2 {
    margin: 0;
    font-family: var(--font-sans);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .portfolio-carousel {
    display: flex;
    min-width: 0;
    gap: 1rem;
    overflow-x: auto;
    padding: 0.25rem 0 0.75rem;
    scroll-snap-type: x mandatory;
    scrollbar-color: var(--color-border) transparent;
  }

  .portfolio-card {
    display: grid;
    flex: 0 0 min(100%, 450px);
    grid-template-columns: clamp(130px, 16vw, 190px) minmax(0, 1fr);
    align-items: center;
    gap: 1.25rem;
    min-height: 150px;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    scroll-snap-align: start;
  }

  .portfolio-image {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-background);
  }

  .portfolio-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 250ms ease;
  }

  .portfolio-card:hover .portfolio-image img {
    transform: scale(1.025);
  }

  .portfolio-image.placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .portfolio-info {
    padding: 1rem 1rem 1rem 0;
  }

  .portfolio-info h3 {
    margin: 0 0 0.35rem;
    font-size: clamp(1.1rem, 2vw, 1.4rem);
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .portfolio-info p {
    margin: 0;
    font-size: 0.9rem;
  }

  .team-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .team-tags span {
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }

  .team-initials {
    display: grid;
    width: 100%;
    height: 100%;
    place-items: center;
    color: var(--color-text-muted);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.06em;
  }

  .empty-state {
    margin: 0;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .portfolio-rows {
      padding-block: 1rem 1.5rem;
    }

    .portfolio-row {
      padding-block: 1rem;
    }

    .portfolio-card {
      flex-basis: min(100%, 390px);
      grid-template-columns: 115px minmax(0, 1fr);
      gap: 1rem;
    }

    .portfolio-info {
      padding-right: 0.75rem;
    }

  }
</style>
