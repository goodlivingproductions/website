---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service },
  }));
}

interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
const { Content } = await render(service);
---
<PageLayout title={service.data.name} description={service.data.description}>
  <section class="service-page">
    <div class="container">
      <a class="back-link" href="/contact/">← Contact</a>
      <p class="eyebrow">Services</p>
      <h1>{service.data.name}</h1>
      <div class="service-intro"><Content /></div>
      <div class="service-placeholder">
        <h2>More details coming soon</h2>
        <p>This page is a functional prototype. Service details and examples will be added as the site develops.</p>
      </div>
      <a class="contact-link" href="/contact/">Contact Good Living Productions →</a>
    </div>
  </section>
</PageLayout>

<style>
  .service-page {
    min-height: 70vh;
    padding-block: clamp(3rem, 8vh, 6rem);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 3rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  .back-link:hover,
  .contact-link:hover {
    color: var(--color-text);
  }

  .eyebrow {
    margin-bottom: 1rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 900px;
    margin-bottom: 1.5rem;
    font-weight: 500;
    font-size: clamp(2.5rem, 7vw, 5rem);
  }

  .service-intro {
    max-width: 700px;
    font-size: 1.1rem;
  }

  .service-placeholder {
    max-width: 700px;
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .service-placeholder h2 {
    margin-bottom: 0.75rem;
    font-size: 1rem;
    letter-spacing: 0;
  }

  .service-placeholder p {
    margin: 0;
    color: var(--color-text-muted);
  }

  .contact-link {
    display: inline-block;
    margin-top: 2rem;
    color: var(--color-text-muted);
    text-underline-offset: 0.2em;
  }
</style>
