---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { site } from '../../data/site.mjs';

export async function getStaticPaths() {
  const [releases, artists] = await Promise.all([
    getCollection('releases'),
    getCollection('artists'),
  ]);

  return releases.map((release) => ({
    params: { slug: release.id },
    props: {
      release,
      artistProfile: artists.find((artist) => artist.id === release.data.artistId),
    },
  }));
}

const { release, artistProfile } = Astro.props;
const teamProfiles = await getCollection('team');

const {
  title,
  artist,
  description,
  cover,
  releaseDate,
  links,
  goodLivingTeam,
  socialImage,
} = release.data;
const releaseUrl = new URL(`/releases/${release.id}/`, site.url).href;
const releaseStructuredData = {
  '@type': 'MusicRecording',
  '@id': `${releaseUrl}#recording`,
  name: title,
  description,
  url: releaseUrl,
  ...(cover ? { image: new URL(cover, site.url).href } : {}),
  ...(releaseDate ? { datePublished: releaseDate.toISOString().slice(0, 10) } : {}),
  byArtist: artistProfile
    ? {
        '@type': artistProfile.data.schemaType,
        '@id': new URL(`/artists/${artistProfile.id}/#artist`, site.url).href,
        name: artistProfile.data.name,
        url: new URL(`/artists/${artistProfile.id}/`, site.url).href,
      }
    : { '@type': 'Person', name: artist },
  ...(links.length ? { sameAs: links.map((link) => link.url) } : {}),
};

const linkedTeam = goodLivingTeam.map((member) => ({
  ...member,
  profileId: teamProfiles.find((profile) => profile.data.name === member.name)?.id,
}));

const formattedDate = releaseDate
  ? releaseDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : undefined;
---

<PageLayout
  title={`${title} — ${artist}`}
  description={description}
  image={socialImage ?? cover}
  imageAlt={`${title} cover artwork`}
  openGraphType="music.song"
  structuredData={releaseStructuredData}
>
  <article class="release-page">
    <section class="release-overview">
      <div class="container release-header-inner">
        {cover && (
          <div class="release-cover">
            <img
              src={cover}
              alt={`${title} by ${artist}`}
            />
          </div>
        )}

        <div class="release-info">
          <h1>{title}</h1>

          <p class="artist">{artist}</p>

          {formattedDate && (
            <time datetime={releaseDate?.toISOString()}>
              {formattedDate}
            </time>
          )}

          {links.length > 0 && (
            <div class="release-links" aria-label="Listen and learn more">
              {links.map((link) => (
                <a href={link.url} target="_blank" rel="noopener noreferrer">
                  {link.label}<span aria-hidden="true"> ↗</span>
                </a>
              ))}
            </div>
          )}

          {goodLivingTeam.length > 0 && (
            <div class="team-credit">
              <p class="team-label">Good Living on this project</p>
              <ul class="team-tags">
                {linkedTeam.map((member) => (
                  <li>
                    {member.profileId ? (
                      <a href={`/team/${member.profileId}/`}>{member.name}</a>
                    ) : (
                      <span>{member.name}</span>
                    )}
                    <span class="team-roles">
                      {member.roles.map((role) => <span class="team-role">{role}</span>)}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  </article>
</PageLayout>

<style>
  .release-overview {
    padding-block: clamp(2.5rem, 6vw, 5rem);
  }

  .release-header-inner {
    display: grid;
    grid-template-columns: minmax(220px, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .release-cover {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .release-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  h1 {
    margin-bottom: 1rem;
    font-weight: 500;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1;
  }

  .artist {
    margin-bottom: 0.5rem;
    color: var(--color-text);
    font-size: 1.25rem;
  }

  time {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .release-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .release-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--color-border);
    font-size: 0.8rem;
    font-weight: 600;
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .release-links a:hover {
    border-color: var(--color-accent);
    background: rgb(189 41 54 / 10%);
    color: var(--color-text);
  }

  .team-credit {
    margin-top: 2.5rem;
  }

  .team-label {
    margin-bottom: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .team-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .team-tags li {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--color-border);
    color: var(--color-text);
    font-size: 0.8rem;
  }

  .team-role {
    color: var(--color-text-muted);
    font-size: 0.72rem;
  }

  .team-roles {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  @media (max-width: 750px) {
    .release-overview {
      padding-block: 1.75rem 3rem;
    }

    .release-header-inner {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .release-cover {
      max-width: 320px;
    }

  }
</style>
