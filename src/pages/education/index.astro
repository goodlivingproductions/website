---
import { getCollection, getEntry, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';

const [education, services] = await Promise.all([
  getEntry('pages', 'education'),
  getCollection('services'),
]);

if (!education) throw new Error('Education page content could not be found.');
const copy = education.data.education;
if (!copy) throw new Error('Education page presentation data could not be found.');
const educationAreas = services
  .sort((a, b) => a.data.order - b.data.order)
  .flatMap((service) => service.data.educationAreas);
const { Content } = await render(education);
---

<PageLayout
  title={education.data.title}
  description={education.data.description}
>
  <section class="page-header">
    <div class="container">
      <p class="eyebrow">{copy.eyebrow}</p>

      <h1>{copy.heading}</h1>

      <div class="intro">
        <Content />
      </div>
    </div>
  </section>

  <section class="lesson-section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">{copy.lessonsEyebrow}</p>
        <h2>{copy.lessonsHeading}</h2>
      </div>

      <div class="lesson-grid">
        {educationAreas.map((area, index) => (
          <article class="lesson">
            <span class="number">{String(index + 1).padStart(2, '0')}</span>
            <h3>{area.name}</h3>
            <p>{area.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="booking">
    <div class="container booking-inner">
      <div>
        <p class="eyebrow">{copy.bookingEyebrow}</p>
        <h2>{copy.bookingHeading}</h2>
        <p>{copy.bookingDescription}</p>
      </div>

      <div class="booking-placeholder">
        <p>{copy.bookingPlaceholderHeading}</p>
        <span>{copy.bookingPlaceholderDescription}</span>
      </div>
    </div>
  </section>
</PageLayout>

<style>
  .page-header {
    padding-block: 8rem 6rem;
  }

  .eyebrow {
    margin-bottom: 2rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 950px;
    margin-bottom: 2rem;
    font-weight: 500;
  }

  .intro {
    max-width: 700px;
  }

  .intro :global(h2),
  .intro :global(h3) {
    display: none;
  }

  .intro :global(p) {
    margin-bottom: 1.5rem;
    font-size: 1.2rem;
  }

  .lesson-section {
    padding-block: 6rem;
    border-top: 1px solid var(--color-border);
  }

  .section-heading {
    margin-bottom: 4rem;
  }

  .section-heading h2 {
    margin-bottom: 0;
    font-weight: 500;
  }

  .lesson-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
    border-left: 1px solid var(--color-border);
  }

  .lesson {
    min-height: 220px;
    padding: 2rem;
    border-right: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .number {
    display: block;
    margin-bottom: 3rem;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
  }

  .lesson h3 {
    margin-bottom: 0.75rem;
    font-weight: 500;
  }

  .lesson p {
    margin-bottom: 0;
  }

  .booking {
    padding-block: 8rem;
    border-top: 1px solid var(--color-border);
  }

  .booking-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: start;
  }

  .booking h2 {
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .booking p {
    max-width: 500px;
  }

  .booking-placeholder {
    min-height: 450px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    text-align: center;
  }

  .booking-placeholder p {
    margin-bottom: 0.5rem;
    color: var(--color-text);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .booking-placeholder span {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 850px) {
    .lesson-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .booking-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 600px) {
    .page-header {
      padding-block: 3.5rem 2.75rem;
    }

    .lesson-section,
    .booking {
      padding-block: 3.5rem;
    }

    .lesson-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .lesson {
      min-height: auto;
      padding: 1rem;
    }

    .number {
      margin-bottom: 1.25rem;
    }

    .lesson h3 {
      font-size: 1.15rem;
    }

    .lesson p {
      font-size: 0.85rem;
    }

    .section-heading {
      margin-bottom: 2rem;
    }

    .booking-placeholder {
      min-height: 280px;
    }
  }

  @media (max-width: 380px) {
    .lesson-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
