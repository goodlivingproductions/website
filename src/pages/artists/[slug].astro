---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ReleaseCard from '../../components/ReleaseCard.astro';
import { site } from '../../data/site.mjs';

export async function getStaticPaths() {
  const [artists, releases] = await Promise.all([
    getCollection('artists'),
    getCollection('releases'),
  ]);

  return artists.map((artist) => ({
    params: { slug: artist.id },
    props: {
      artist,
      releases: releases
        .filter((release) => release.data.artistId === artist.id)
        .sort((a, b) => (b.data.releaseDate?.getTime() ?? 0) - (a.data.releaseDate?.getTime() ?? 0)),
    },
  }));
}

const { artist, releases } = Astro.props;
const { Content } = await render(artist);

const {
  name,
  description,
  image,
  socialImage,
  schemaType,
  instagramUrl,
} = artist.data;
const artistUrl = new URL(`/artists/${artist.id}/`, site.url).href;
const artistStructuredData = {
  '@type': 'ProfilePage',
  '@id': `${artistUrl}#profile`,
  url: artistUrl,
  name: `${name} | ${site.shortName}`,
  mainEntity: {
    '@type': schemaType,
    '@id': `${artistUrl}#artist`,
    name,
    description,
    url: artistUrl,
    ...(image ? { image: new URL(image, site.url).href } : {}),
    ...(instagramUrl ? { sameAs: [instagramUrl] } : {}),
  },
};
---

<PageLayout
  title={name}
  description={description}
  image={socialImage ?? image}
  imageAlt={`${name} artist portrait`}
  openGraphType="profile"
  structuredData={artistStructuredData}
>
  <article class="artist-page">
    <section class="artist-header">
      <div class="container artist-header-inner">
        {image && (
          <div class="artist-image">
            <img
              src={image}
              alt={name}
            />
          </div>
        )}

        <div class="artist-intro">
          <p class="eyebrow">Artist</p>

          <h1>{name}</h1>

          <p class="description">
            {description}
          </p>

          {instagramUrl && (
            <a class="artist-social-link" href={instagramUrl} target="_blank" rel="noopener noreferrer">
              Instagram <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="artist-content">
      <div class="container content-grid">
        <div class="content">
          <Content />
        </div>

        {releases.length > 0 && (
          <section class="artist-releases" aria-labelledby="artist-releases-heading">
            <h2 id="artist-releases-heading">Selected releases</h2>
            <div class="release-grid">
              {releases.map((release) => <ReleaseCard release={release} />)}
            </div>
          </section>
        )}
      </div>
    </section>
  </article>
</PageLayout>

<style>
  .artist-header {
    padding-block: 7rem;
    border-bottom: 1px solid var(--color-border);
  }

  .artist-header-inner {
    display: grid;
    grid-template-columns: minmax(280px, 0.8fr) 1.2fr;
    gap: 5rem;
    align-items: center;
  }

  .artist-image {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .artist-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .eyebrow {
    margin-bottom: 1.5rem;
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  h1 {
    margin-bottom: 1.5rem;
    font-weight: 500;
  }

  .description {
    max-width: 600px;
    font-size: 1.2rem;
  }

  .artist-social-link {
    display: inline-flex;
    gap: 0.35rem;
    margin-top: 0.5rem;
    color: var(--color-text);
    font-size: 0.9rem;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .artist-content {
    padding-block: 6rem 8rem;
  }

  .content-grid {
    display: grid;
    grid-template-columns: minmax(0, 800px);
    justify-content: center;
  }

  .artist-releases {
    margin-top: 4rem;
  }

  .artist-releases h2 {
    margin-bottom: 1.5rem;
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 500;
  }

  .release-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
  }

  @media (max-width: 750px) {
    .release-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }
  }

  .content :global(h2) {
    margin-top: 4rem;
    margin-bottom: 1.5rem;
    font-size: clamp(1.75rem, 4vw, 3rem);
    font-weight: 500;
  }

  .content :global(h3) {
    margin-top: 3rem;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .content :global(p) {
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
  }

  .content :global(ul) {
    padding-left: 1.25rem;
    color: var(--color-text-muted);
  }

  .content :global(li) {
    margin-bottom: 0.5rem;
  }

  .content :global(a) {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 750px) {
    .artist-header {
      padding-block: 3.5rem;
    }

    .artist-header-inner {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }

    .artist-image {
      max-width: 340px;
      margin-inline: auto;
    }

    .artist-content {
      padding-block: 3.5rem;
    }
  }
</style>
